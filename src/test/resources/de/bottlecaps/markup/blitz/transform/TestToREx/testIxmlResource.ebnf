// Alternatives are followed by an <?ixml ...?> annotation that holds them in ixml notation, so that
// they are not folded when they differ in what they yield. For alternatives that are just a
// character or token, without deletion, the annotation is for information only, and is abbreviated
// by ... when it is long.
// In order to have REx take the annotations into account, use REx option: -a ixml

_start        ::= ixml _end
ixml          ::= s _ixml_option _ixml_list s     <?ixml -s, -_ixml_option, -_ixml_list, -s?>
_ixml_option  ::=                                 <?ixml ?>
                | prolog RS                       <?ixml ^prolog, -RS?>
_ixml_list    ::= rule                            <?ixml ^rule?>
                | _ixml_list RS rule              <?ixml -_ixml_list, -RS, ^rule?>
s             ::=                                 <?ixml ?>
                | s _s_choice                     <?ixml -s, -_s_choice?>
_s_choice     ::= _s_deleted_chars                <?ixml -[#9-#a; #d]?>
                | _s_deleted_chars_1              <?ixml -[' '; #a0; #1680; #2000-#200a; #202f; #205f; #3000]?>
                | comment                         <?ixml ^comment?>
prolog        ::= version                         <?ixml ^version?>
RS            ::= _s_choice                       <?ixml -_s_choice?>
                | RS _s_choice                    <?ixml -RS, -_s_choice?>
rule          ::= naming _rule_deleted_chars s alts '.'
                                                  <?ixml -naming, -['=:'], -s, -alts, -['.']?>
comment       ::= '{' _comment_list_option '}'    <?ixml -['{'], -_comment_list_option, -['}']?>
_comment_choice
              ::= _comment_preserved_chars        <?ixml [#0-#8; #b-#c; #e-#1f; #7f-#9f]?>
                | _s_preserved_chars              <?ixml [#9-#a; #d]?>
                | _s_preserved_chars_1            <?ixml [' '; #a0; #1680; #2000-#200a; #202f; ...?>
                | _dchar_preserved_chars          <?ixml ['!'; '$'-'&'; '/'; '<'; '\'; '`'; #a1...?>
                | '"'                             <?ixml ['"']?>
                | '#'                             <?ixml ['#']?>
                | "'"                             <?ixml ["'"]?>
                | '('                             <?ixml ['(']?>
                | ')'                             <?ixml [')']?>
                | '*'                             <?ixml ['*']?>
                | '+'                             <?ixml ['+']?>
                | ','                             <?ixml [',']?>
                | '-'                             <?ixml ['-']?>
                | '.'                             <?ixml ['.']?>
                | _hex_preserved_chars            <?ixml ['0'-'9']?>
                | _rule_preserved_chars           <?ixml [':'; '=']?>
                | _alts_preserved_chars           <?ixml [';'; '|']?>
                | '>'                             <?ixml ['>']?>
                | '?'                             <?ixml ['?']?>
                | '@'                             <?ixml ['@']?>
                | _hex_preserved_chars_1          <?ixml ['A'-'F']?>
                | _capital_preserved_chars        <?ixml ['G'-'Z']?>
                | '['                             <?ixml ['[']?>
                | ']'                             <?ixml [']']?>
                | '^'                             <?ixml ['^']?>
                | _namestart_preserved_chars      <?ixml ['_'; #aa; #b5; #ba; #c0-#d6; #d8-#f6;...?>
                | _hex_preserved_chars_2          <?ixml ['a'-'d'; 'f']?>
                | 'e'                             <?ixml ['e']?>
                | _letter_preserved_chars         <?ixml ['g'-'h'; 'j'-'k'; 'p'-'q'; 't'-'u'; '...?>
                | 'i'                             <?ixml ['i']?>
                | 'l'                             <?ixml ['l']?>
                | 'm'                             <?ixml ['m']?>
                | 'n'                             <?ixml ['n']?>
                | 'o'                             <?ixml ['o']?>
                | 'r'                             <?ixml ['r']?>
                | 's'                             <?ixml ['s']?>
                | 'v'                             <?ixml ['v']?>
                | 'x'                             <?ixml ['x']?>
                | '~'                             <?ixml ['~']?>
                | _namefollower_preserved_chars   <?ixml [#b7; #300-#36f; #483-#487; #591-#5bd;...?>
                | comment                         <?ixml ^comment?>
_comment_list_option
              ::=                                 <?ixml ?>
                | _comment_list_option _comment_choice
                                                  <?ixml -_comment_list_option, -_comment_choice?>
version       ::= 'i' 'x' 'm' 'l' RS 'v' 'e' 'r' 's' 'i' 'o' 'n' RS string s '.'
                                                  <?ixml -['i'], -['x'], -['m'], -['l'], -RS, -['v'], -['e'], -['r'], -['s'], -['i'], -['o'], -['n'], -RS, @string, -s, -['.']?>
naming        ::= _naming_option name s _naming_option_1
                                                  <?ixml -_naming_option, @name, -s, -_naming_option_1?>
_naming_option
              ::=                                 <?ixml ?>
                | mark s                          <?ixml @mark, -s?>
_naming_option_1
              ::=                                 <?ixml ?>
                | '>' s alias s                   <?ixml -['>'], -s, @alias, -s?>
alts          ::= alt                             <?ixml ^alt?>
                | alts _alts_deleted_chars s alt  <?ixml -alts, -[';|'], -s, ^alt?>
string        ::= '"' _string_list '"'            <?ixml -['"'], -_string_list, -['"']?>
                | "'" _string_list_1 "'"          <?ixml -["'"], -_string_list_1, -["'"]?>
_string_list  ::= dchar                           <?ixml ^dchar?>
                | _string_list dchar              <?ixml -_string_list, ^dchar?>
_string_list_1
              ::= schar                           <?ixml ^schar?>
                | _string_list_1 schar            <?ixml -_string_list_1, ^schar?>
mark          ::= '-'                             <?ixml ['-']?>
                | '@'                             <?ixml ['@']?>
                | '^'                             <?ixml ['^']?>
name          ::= namestart _name_list_option     <?ixml -namestart, -_name_list_option?>
namestart     ::= _hex_preserved_chars_1          <?ixml ['A'-'F']?>
                | _capital_preserved_chars        <?ixml ['G'-'Z']?>
                | _namestart_preserved_chars      <?ixml ['_'; #aa; #b5; #ba; #c0-#d6; #d8-#f6;...?>
                | _hex_preserved_chars_2          <?ixml ['a'-'d'; 'f']?>
                | 'e'                             <?ixml ['e']?>
                | _letter_preserved_chars         <?ixml ['g'-'h'; 'j'-'k'; 'p'-'q'; 't'-'u'; '...?>
                | 'i'                             <?ixml ['i']?>
                | 'l'                             <?ixml ['l']?>
                | 'm'                             <?ixml ['m']?>
                | 'n'                             <?ixml ['n']?>
                | 'o'                             <?ixml ['o']?>
                | 'r'                             <?ixml ['r']?>
                | 's'                             <?ixml ['s']?>
                | 'v'                             <?ixml ['v']?>
                | 'x'                             <?ixml ['x']?>
namefollower  ::= '-'                             <?ixml ['-']?>
                | '.'                             <?ixml ['.']?>
                | _hex_preserved_chars            <?ixml ['0'-'9']?>
                | _hex_preserved_chars_1          <?ixml ['A'-'F']?>
                | _capital_preserved_chars        <?ixml ['G'-'Z']?>
                | _namestart_preserved_chars      <?ixml ['_'; #aa; #b5; #ba; #c0-#d6; #d8-#f6;...?>
                | _hex_preserved_chars_2          <?ixml ['a'-'d'; 'f']?>
                | 'e'                             <?ixml ['e']?>
                | _letter_preserved_chars         <?ixml ['g'-'h'; 'j'-'k'; 'p'-'q'; 't'-'u'; '...?>
                | 'i'                             <?ixml ['i']?>
                | 'l'                             <?ixml ['l']?>
                | 'm'                             <?ixml ['m']?>
                | 'n'                             <?ixml ['n']?>
                | 'o'                             <?ixml ['o']?>
                | 'r'                             <?ixml ['r']?>
                | 's'                             <?ixml ['s']?>
                | 'v'                             <?ixml ['v']?>
                | 'x'                             <?ixml ['x']?>
                | _namefollower_preserved_chars   <?ixml [#b7; #300-#36f; #483-#487; #591-#5bd;...?>
_name_list_option
              ::=                                 <?ixml ?>
                | _name_list_option namefollower  <?ixml -_name_list_option, -namefollower?>
alias         ::= name                            <?ixml @name?>
alt           ::=                                 <?ixml ?>
                | _alt_list                       <?ixml -_alt_list?>
_alt_list     ::= term                            <?ixml -term?>
                | _alt_list ',' s term            <?ixml -_alt_list, -[','], -s, -term?>
dchar         ::= _s_preserved_chars_1            <?ixml [' '; #a0; #1680; #2000-#200a; #202f; ...?>
                | _dchar_preserved_chars          <?ixml ['!'; '$'-'&'; '/'; '<'; '\'; '`'; #a1...?>
                | '#'                             <?ixml ['#']?>
                | "'"                             <?ixml ["'"]?>
                | '('                             <?ixml ['(']?>
                | ')'                             <?ixml [')']?>
                | '*'                             <?ixml ['*']?>
                | '+'                             <?ixml ['+']?>
                | ','                             <?ixml [',']?>
                | '-'                             <?ixml ['-']?>
                | '.'                             <?ixml ['.']?>
                | _hex_preserved_chars            <?ixml ['0'-'9']?>
                | _rule_preserved_chars           <?ixml [':'; '=']?>
                | _alts_preserved_chars           <?ixml [';'; '|']?>
                | '>'                             <?ixml ['>']?>
                | '?'                             <?ixml ['?']?>
                | '@'                             <?ixml ['@']?>
                | _hex_preserved_chars_1          <?ixml ['A'-'F']?>
                | _capital_preserved_chars        <?ixml ['G'-'Z']?>
                | '['                             <?ixml ['[']?>
                | ']'                             <?ixml [']']?>
                | '^'                             <?ixml ['^']?>
                | _namestart_preserved_chars      <?ixml ['_'; #aa; #b5; #ba; #c0-#d6; #d8-#f6;...?>
                | _hex_preserved_chars_2          <?ixml ['a'-'d'; 'f']?>
                | 'e'                             <?ixml ['e']?>
                | _letter_preserved_chars         <?ixml ['g'-'h'; 'j'-'k'; 'p'-'q'; 't'-'u'; '...?>
                | 'i'                             <?ixml ['i']?>
                | 'l'                             <?ixml ['l']?>
                | 'm'                             <?ixml ['m']?>
                | 'n'                             <?ixml ['n']?>
                | 'o'                             <?ixml ['o']?>
                | 'r'                             <?ixml ['r']?>
                | 's'                             <?ixml ['s']?>
                | 'v'                             <?ixml ['v']?>
                | 'x'                             <?ixml ['x']?>
                | '{'                             <?ixml ['{']?>
                | '}'                             <?ixml ['}']?>
                | '~'                             <?ixml ['~']?>
                | _namefollower_preserved_chars   <?ixml [#b7; #300-#36f; #483-#487; #591-#5bd;...?>
                | '"' '"'                         <?ixml ['"'], -['"']?>
schar         ::= _s_preserved_chars_1            <?ixml [' '; #a0; #1680; #2000-#200a; #202f; ...?>
                | _dchar_preserved_chars          <?ixml ['!'; '$'-'&'; '/'; '<'; '\'; '`'; #a1...?>
                | '"'                             <?ixml ['"']?>
                | '#'                             <?ixml ['#']?>
                | '('                             <?ixml ['(']?>
                | ')'                             <?ixml [')']?>
                | '*'                             <?ixml ['*']?>
                | '+'                             <?ixml ['+']?>
                | ','                             <?ixml [',']?>
                | '-'                             <?ixml ['-']?>
                | '.'                             <?ixml ['.']?>
                | _hex_preserved_chars            <?ixml ['0'-'9']?>
                | _rule_preserved_chars           <?ixml [':'; '=']?>
                | _alts_preserved_chars           <?ixml [';'; '|']?>
                | '>'                             <?ixml ['>']?>
                | '?'                             <?ixml ['?']?>
                | '@'                             <?ixml ['@']?>
                | _hex_preserved_chars_1          <?ixml ['A'-'F']?>
                | _capital_preserved_chars        <?ixml ['G'-'Z']?>
                | '['                             <?ixml ['[']?>
                | ']'                             <?ixml [']']?>
                | '^'                             <?ixml ['^']?>
                | _namestart_preserved_chars      <?ixml ['_'; #aa; #b5; #ba; #c0-#d6; #d8-#f6;...?>
                | _hex_preserved_chars_2          <?ixml ['a'-'d'; 'f']?>
                | 'e'                             <?ixml ['e']?>
                | _letter_preserved_chars         <?ixml ['g'-'h'; 'j'-'k'; 'p'-'q'; 't'-'u'; '...?>
                | 'i'                             <?ixml ['i']?>
                | 'l'                             <?ixml ['l']?>
                | 'm'                             <?ixml ['m']?>
                | 'n'                             <?ixml ['n']?>
                | 'o'                             <?ixml ['o']?>
                | 'r'                             <?ixml ['r']?>
                | 's'                             <?ixml ['s']?>
                | 'v'                             <?ixml ['v']?>
                | 'x'                             <?ixml ['x']?>
                | '{'                             <?ixml ['{']?>
                | '}'                             <?ixml ['}']?>
                | '~'                             <?ixml ['~']?>
                | _namefollower_preserved_chars   <?ixml [#b7; #300-#36f; #483-#487; #591-#5bd;...?>
                | "'" "'"                         <?ixml ["'"], -["'"]?>
term          ::= factor                          <?ixml -factor?>
                | option                          <?ixml ^option?>
                | repeat0                         <?ixml ^repeat0?>
                | repeat1                         <?ixml ^repeat1?>
factor        ::= terminal                        <?ixml -terminal?>
                | nonterminal                     <?ixml ^nonterminal?>
                | insertion                       <?ixml ^insertion?>
                | '(' s alts ')' s                <?ixml -['('], -s, ^alts, -[')'], -s?>
option        ::= factor '?' s                    <?ixml -factor, -['?'], -s?>
repeat0       ::= factor _repeat0_choice          <?ixml -factor, -_repeat0_choice?>
_repeat0_choice
              ::= '*' s                           <?ixml -['*'], -s?>
                | '*' '*' s sep                   <?ixml -['*'], -['*'], -s, ^sep?>
repeat1       ::= factor _repeat1_choice          <?ixml -factor, -_repeat1_choice?>
_repeat1_choice
              ::= '+' s                           <?ixml -['+'], -s?>
                | '+' '+' s sep                   <?ixml -['+'], -['+'], -s, ^sep?>
terminal      ::= literal                         <?ixml ^literal?>
                | charset                         <?ixml -charset?>
nonterminal   ::= naming                          <?ixml -naming?>
insertion     ::= '+' s _insertion_choice s       <?ixml -['+'], -s, -_insertion_choice, -s?>
_insertion_choice
              ::= string                          <?ixml @string?>
                | '#' hex                         <?ixml -['#'], @hex?>
sep           ::= factor                          <?ixml -factor?>
literal       ::= quoted                          <?ixml -quoted?>
                | encoded                         <?ixml -encoded?>
charset       ::= inclusion                       <?ixml ^inclusion?>
                | exclusion                       <?ixml ^exclusion?>
hex           ::= _hex_choice                     <?ixml -_hex_choice?>
                | hex _hex_choice                 <?ixml -hex, -_hex_choice?>
_hex_choice   ::= _hex_preserved_chars            <?ixml ['0'-'9']?>
                | _hex_preserved_chars_1          <?ixml ['A'-'F']?>
                | _hex_preserved_chars_2          <?ixml ['a'-'d'; 'f']?>
                | 'e'                             <?ixml ['e']?>
quoted        ::= _quoted_option string s         <?ixml -_quoted_option, @string, -s?>
_quoted_option
              ::=                                 <?ixml ?>
                | tmark s                         <?ixml @tmark, -s?>
encoded       ::= _quoted_option '#' hex s        <?ixml -_quoted_option, -['#'], @hex, -s?>
inclusion     ::= _quoted_option set              <?ixml -_quoted_option, -set?>
exclusion     ::= _quoted_option '~' s set        <?ixml -_quoted_option, -['~'], -s, -set?>
tmark         ::= '-'                             <?ixml ['-']?>
                | '^'                             <?ixml ['^']?>
set           ::= '[' s _set_list_option ']' s    <?ixml -['['], -s, -_set_list_option, -[']'], -s?>
_set_list     ::= member s                        <?ixml ^member, -s?>
                | _set_list _alts_deleted_chars s member s
                                                  <?ixml -_set_list, -[';|'], -s, ^member, -s?>
_set_list_option
              ::=                                 <?ixml ?>
                | _set_list                       <?ixml -_set_list?>
member        ::= string                          <?ixml @string?>
                | '#' hex                         <?ixml -['#'], @hex?>
                | range                           <?ixml -range?>
                | class                           <?ixml -class?>
range         ::= from s '-' s to                 <?ixml @from, -s, -['-'], -s, @to?>
class         ::= code                            <?ixml @code?>
from          ::= character                       <?ixml -character?>
to            ::= character                       <?ixml -character?>
code          ::= capital _code_option            <?ixml -capital, -_code_option?>
capital       ::= _hex_preserved_chars_1          <?ixml ['A'-'F']?>
                | _capital_preserved_chars        <?ixml ['G'-'Z']?>
letter        ::= _hex_preserved_chars_1          <?ixml ['A'-'F']?>
                | _capital_preserved_chars        <?ixml ['G'-'Z']?>
                | _hex_preserved_chars_2          <?ixml ['a'-'d'; 'f']?>
                | 'e'                             <?ixml ['e']?>
                | _letter_preserved_chars         <?ixml ['g'-'h'; 'j'-'k'; 'p'-'q'; 't'-'u'; '...?>
                | 'i'                             <?ixml ['i']?>
                | 'l'                             <?ixml ['l']?>
                | 'm'                             <?ixml ['m']?>
                | 'n'                             <?ixml ['n']?>
                | 'o'                             <?ixml ['o']?>
                | 'r'                             <?ixml ['r']?>
                | 's'                             <?ixml ['s']?>
                | 'v'                             <?ixml ['v']?>
                | 'x'                             <?ixml ['x']?>
_code_option  ::=                                 <?ixml ?>
                | letter                          <?ixml -letter?>
character     ::= '"' dchar '"'                   <?ixml -['"'], ^dchar, -['"']?>
                | "'" schar "'"                   <?ixml -["'"], ^schar, -["'"]?>
                | '#' hex                         <?ixml ['#'], @hex?>

<?TOKENS?>

_end          ::= $
_s_deleted_chars
              ::= [#x9-#xa]
                | #xd
_s_deleted_chars_1
              ::= ' '
                | #xa0
                | #x1680
                | [#x2000-#x200a]
                | #x202f
                | #x205f
                | #x3000
_rule_deleted_chars
              ::= ':'
                | '='
_comment_preserved_chars
              ::= [#x0-#x8]
                | [#xb-#xc]
                | [#xe-#x1f]
                | [#x7f-#x9f]
_s_preserved_chars
              ::= [#x9-#xa]
                | #xd
_s_preserved_chars_1
              ::= ' '
                | #xa0
                | #x1680
                | [#x2000-#x200a]
                | #x202f
                | #x205f
                | #x3000
_dchar_preserved_chars
              ::= '!'
                | [$-&]
                | '/'
                | '<'
                | '\'
                | '`'
                | [#xa1-#xa9]
                | [#xab-#xb4]
                | #xb6
                | [#xb8-#xb9]
                | [#xbb-#xbf]
                | #xd7
                | #xf7
                | [#x2c2-#x2c5]
